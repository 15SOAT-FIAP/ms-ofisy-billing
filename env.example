# Banco de dados
POSTGRES_DB=ms_ofisy_billing_db
POSTGRES_USER=admin_db
POSTGRES_PASSWORD=change-me

# Cliente HTTP síncrono para o core (consulta de preço no catálogo de serviços)
CORE_BASE_URL=http://localhost:8080
CORE_SERVICE_TOKEN=change-me

# Cliente HTTP síncrono para o ms-ofisy-stock (nome e preço do produto na hora de montar o orçamento)
STOCK_BASE_URL=http://localhost:8082
STOCK_SERVICE_TOKEN=change-me

# Mercado Pago (Orders API): Access Token da aplicação, de teste no sandbox
MERCADOPAGO_ACCESS_TOKEN=change-me
